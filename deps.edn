{:paths ["src" "resources"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/html {:git/url "https://github.com/kotoba-lang/html.git"
         :git/sha "04606d97309fa377a20d18ee123e5db8f59ad127"}
        io.github.kotoba-lang/css  {:git/url "https://github.com/kotoba-lang/css.git"
         :git/sha "4654260a9b06e3c98bd6e02c877612c0a1f2d7a9"}
        io.github.kotoba-lang/datalog {:git/url "https://github.com/kotoba-lang/datalog.git"
         :git/sha "d18513af533917539c56435de6fb1426738da31a"}
        io.github.kotoba-lang/edn {:git/url "https://github.com/kotoba-lang/edn.git"
         :git/sha "250f4dafa5f5c7fb3109703496a52866e2a62dcd"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {org.clojure/data.csv {:mvn/version "1.1.0"}
                      org.clojure/data.json {:mvn/version "2.5.1"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}
  :collect {:extra-deps {org.clojure/data.json {:mvn/version "2.5.1"}}
            :main-opts ["-m" "kotoba.property.collector"]}
  :collect-hmlr {:extra-deps {org.clojure/data.csv {:mvn/version "1.1.0"}}
                 :main-opts ["-m" "kotoba.property.hmlr"]}
  :collect-nyc {:extra-deps {org.clojure/data.json {:mvn/version "2.5.1"}}
                :main-opts ["-m" "kotoba.property.nyc"]}
  :query {:main-opts ["-m" "kotoba.property.query"]}}}
