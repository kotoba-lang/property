  {:authority/id "EU-EEA/UBO-registers"
   :jurisdiction "EU-EEA"
   :authority "Member-state beneficial-ownership registers"
   :dataset "General-public UBO access"
   :status :deny
   :property-owner-data? false
   :natural-person-ubo-data? true
   :url "https://curia.europa.eu/site/upload/docs/application/pdf/2022-11/cp220188en.pdf"
   :reviewed-at "2026-07-10"
   :note "Do not treat general-public access as an unrestricted redistribution licence."}]}
