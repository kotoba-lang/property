   :property-owner-data? false
   :natural-person-ubo-data? true
   :url "https://download.companieshouse.gov.uk/en_pscdata.html"
   :reviewed-at "2026-07-10"
   :note "Public source; privacy, correction, suppression and reuse controls required."}
  {:authority/id "GB-ENG-WLS/HM-Land-Registry"
