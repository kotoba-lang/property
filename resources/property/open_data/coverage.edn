   :natural-person-ubo-data? false
   :url "https://data.cityofnewyork.us/d/ynxg-k94i"
   :reviewed-at "2026-07-10"}
  {:authority/id "GB/Companies-House"
   :jurisdiction "GB"
   :authority "Companies House"
   :dataset "PSC and Register of Overseas Entities"
